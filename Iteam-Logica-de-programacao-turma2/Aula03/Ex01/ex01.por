Algoritmo "Dobro e Triplo"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professora   :  
// Descrição   : Crie um algoritmo que leia um número inteiro e exiba o seu dobro
// Autor(a)    : Joadson Rocha 
// Data atual  : 03/08/2026
Var
// Seção de Declarações das variáveis nome
numero, dobro: inteiro


Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
     escreval("Digite seu nomero: ")
     leia(numero)
     dobro <- numero*2     // atrinuicão
     triplo <- numero*3
     
     escreval("Você digitou o numero: ",numero," e o seu dobro é:  ",dobro," e o triplo é:", triplo)
     

Fimalgoritmo