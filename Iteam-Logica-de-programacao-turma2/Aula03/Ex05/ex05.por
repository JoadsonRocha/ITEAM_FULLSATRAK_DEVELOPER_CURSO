Algoritmo "salário mensal"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professora   :  Helida Batista
// Descrição   : Calcule o salário mensal de um funcionário que recebe por hora trabalhada.
// Autor(a)    : Joadson Rocha 
// Data atual  : 03/08/2026
Var
// Seção de Declarações das variáveis nome
horas: inteiro


Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
   escreval("Digite as horas trabalhadas: ")
   leia(horas)
   salario <- horas*40
   escreval("Seu salário é: R$ ", salario)
     
Fimalgoritmo